{
  "name": "gatekeeper-mcp",
  "version": "1.0.0",
  "description": "Local MCP server that prevents Action Bias in coding agents.",
  "type": "module",
  "bin": {
    "gatekeeper-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": ["dist", "README.md", "LICENSE", "SKILL.md", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "gatekeeper",
    "action-bias",
    "coding-agent"
  ],
  "author": "blxnkl1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blxnkl1/GATEKEEPER-MCP.git"
  },
  "homepage": "https://github.com/blxnkl1/GATEKEEPER-MCP#readme",
  "bugs": {
    "url": "https://github.com/blxnkl1/GATEKEEPER-MCP/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.14.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
